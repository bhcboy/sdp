<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WEATHER MONITORING SYSTEM"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <EditText
        android:id="@+id/etId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtTitle"
        android:hint="Report ID"/>

    <EditText
        android:id="@+id/etCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etId"
        android:hint="City Name"/>

    <EditText
        android:id="@+id/etTemperature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etCity"
        android:hint="Temperature"/>

    <EditText
        android:id="@+id/etHumidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etTemperature"
        android:hint="Humidity"/>

    <EditText
        android:id="@+id/etCondition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etHumidity"
        android:hint="Weather Condition"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etCondition"
        android:text="SAVE REPORT"/>

    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnSave"
        android:text="UPDATE"/>

    <Button
        android:id="@+id/btnView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnUpdate"
        android:text="VIEW REPORTS"/>

    <TextView
        android:id="@+id/txtResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnView"
        android:text="Result"
        android:textSize="16sp"/>

</RelativeLayout>

WeatherDatabaseHelper.java
package com.example.myapplication;

import android.content.ContentValues;
import android.content.Context;
import android.database.Cursor;
import android.database.sqlite.SQLiteDatabase;
import android.database.sqlite.SQLiteOpenHelper;

public class WeatherDatabaseHelper extends SQLiteOpenHelper {

    public WeatherDatabaseHelper(Context c) {
        super(c, "WeatherReports.db", null, 1);
    }

    @Override
    public void onCreate(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE WeatherReports (" +
                "Report_ID INTEGER PRIMARY KEY AUTOINCREMENT," +
                "City_Name TEXT," +
                "Temperature TEXT," +
                "Humidity TEXT," +
                "Weather_Condition TEXT)");
    }

    @Override
    public void onUpgrade(SQLiteDatabase db, int oldV, int newV) {
        db.execSQL("DROP TABLE IF EXISTS WeatherReports");
        onCreate(db);
    }

    public void insert(String[] data) {
        ContentValues v = new ContentValues();
        v.put("City_Name", data[0]);
        v.put("Temperature", data[1]);
        v.put("Humidity", data[2]);
        v.put("Weather_Condition", data[3]);

        getWritableDatabase().insert("WeatherReports", null, v);
    }

    public Cursor getAll() {
        return getReadableDatabase().rawQuery(
                "SELECT * FROM WeatherReports", null);
    }

    public void update(int id, String[] data) {
        ContentValues v = new ContentValues();
        v.put("City_Name", data[0]);
        v.put("Temperature", data[1]);
        v.put("Humidity", data[2]);
        v.put("Weather_Condition", data[3]);

        getWritableDatabase().update(
                "WeatherReports", v, "Report_ID=?",
                new String[]{String.valueOf(id)});
    }
}

MainActivity.java
package com.example.myapplication;

import android.os.Bundle;
import android.database.Cursor;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText id, city, temperature, humidity, condition;
    WeatherDatabaseHelper db;
    TextView result;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_main);

        id = findViewById(R.id.etId);
        city = findViewById(R.id.etCity);
        temperature = findViewById(R.id.etTemperature);
        humidity = findViewById(R.id.etHumidity);
        condition = findViewById(R.id.etCondition);
        result = findViewById(R.id.txtResult);

        db = new WeatherDatabaseHelper(this);

        findViewById(R.id.btnSave).setOnClickListener(v ->
            db.insert(new String[]{
                city.getText().toString(),
                temperature.getText().toString(),
                humidity.getText().toString(),
                condition.getText().toString()
            }));

        findViewById(R.id.btnUpdate).setOnClickListener(v ->
            db.update(
                Integer.parseInt(id.getText().toString()),
                new String[]{
                    city.getText().toString(),
                    temperature.getText().toString(),
                    humidity.getText().toString(),
                    condition.getText().toString()
                }));

        findViewById(R.id.btnView).setOnClickListener(v -> {
            Cursor c = db.getAll();
            String s = "";

            while (c.moveToNext()) {
                for (int i = 0; i < c.getColumnCount(); i++)
                    s += c.getColumnName(i) + ": "
                            + c.getString(i) + "\n";
                s += "\n";
            }

            result.setText(s);
            c.close();
        });
    }
}
